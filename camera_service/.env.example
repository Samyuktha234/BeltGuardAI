# Copy this file to `.env` in the same folder and edit the values for
# your setup.

# ---- Camera source ----
# "webcam" (default) uses the laptop's own built-in/USB webcam via
# cv2.VideoCapture(CAMERA_INDEX). This is the default camera source —
# no Android phone, IP Webcam app, or mobile Wi-Fi stream is needed.
CAMERA_SOURCE=ip

# Which webcam to open when CAMERA_SOURCE=webcam. 0 is almost always
# the laptop's built-in camera. If you have multiple cameras attached
# (e.g. a USB webcam too), try 1, 2, etc.
CAMERA_INDEX=0

# ---- Optional: IP Webcam (Android phone) ----
# Only used when CAMERA_SOURCE=ip above. Open the IP Webcam app on the
# phone, tap "Start server", and use the URL it shows under "Video
# streams" — the MJPEG stream, not the HTML preview page. Common
# examples:
#   http://192.168.1.42:8080/video
#   http://192.168.1.42:8080/videofeed
# Replace 192.168.1.42 with the phone's actual IP on your Wi-Fi network.
IP_CAMERA_URL=http://192.168.43.201:8080/video

# ---- Backend (Node/Express) ----
# Where this service POSTs structured observations. Usually the same
# laptop this service runs on.
BACKEND_URL=http://localhost:5000

# ---- Processing ----
# Target processing rate (frames per second). Keeps CPU usage down
# while still producing smooth belt/motion readings.
PROCESS_FPS=6

# Max width frames are resized to before processing (keeps CPU usage
# reasonable). Aspect ratio is preserved.
MAX_FRAME_WIDTH=480

# ---- Belt ROI (region of interest) ----
# Normalized (0.0-1.0) coordinates of the box the belt is expected to
# occupy in-frame, measured from the top-left corner. Adjust these
# after positioning the camera so the ROI actually covers the belt.
# See README.md for how to tune this.
ROI_X=0.1
ROI_Y=0.35
ROI_WIDTH=0.8
ROI_HEIGHT=0.3

# ---- Joint/visual inspection ROI ----
# A smaller box (also normalized) inside/near the belt ROI where the
# visible joint/splice sits, used for visual anomaly inspection.
JOINT_ROI_X=0.42
JOINT_ROI_Y=0.35
JOINT_ROI_WIDTH=0.16
JOINT_ROI_HEIGHT=0.3

# ---- Freshness / reconnect ----
# How long (seconds) to wait after a failed frame read before retrying
# the camera connection.
RECONNECT_DELAY_SEC=3

# ---- Conservative anomaly logic ----
# Number of consecutive frames a visual anomaly must be observed in
# before it is allowed to escalate beyond ADVISORY severity.
ANOMALY_PERSISTENCE_FRAMES=8
# Rolling window size (frames) used to smooth anomaly/motion scores.
SMOOTHING_WINDOW=15

# ---- Annotated snapshot (dashboard Camera Analysis card) ----
# A still, annotated JPEG of what the pipeline is currently seeing —
# NOT a live video stream. Set to false to disable entirely (the
# dashboard falls back to text-only evidence).
SNAPSHOT_ENABLED=true
# Max width (px) of the snapshot sent to the backend.
SNAPSHOT_MAX_WIDTH=480
# JPEG quality (1-100). Lower = smaller payload, more compression.
SNAPSHOT_JPEG_QUALITY=70
# Only build+send a snapshot every N processed frames (at PROCESS_FPS)
# to save bandwidth/CPU. 1 = every frame, 2 = every other frame.
SNAPSHOT_EVERY_N_FRAMES=12
