# Copy this file to `.env` in the backend/ folder and fill in your values.
# The backend runs fine with none of this set — SMS alerts simply stay
# "NOT_CONFIGURED" and everything else (dashboard, camera, fusion) works
# normally.

# ---- Server ----
PORT=5000

# ---- Twilio SMS + voice escalation (optional) ----
# Create a free Twilio trial account at https://www.twilio.com/try-twilio
# to get these. All four must be set for SMS alerts AND the CRITICAL
# voice call (same credentials) to activate.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio phone number you were assigned (E.164 format, e.g. +15551234567)
TWILIO_PHONE_NUMBER=
# The phone that should receive CRITICAL alerts (E.164 format, e.g. +919876543210)
ALERT_RECIPIENT_PHONE=
# Public, internet-reachable URL of the voice-call TwiML instruction endpoint.
# REQUIRED for the automated call (trial accounts only accept `url`, not inline
# `twiml`). Default: https://<your-backend>/api/twilio/voice-twiml — the backend
# serves this path itself; it just has to be reachable from the internet
# (deployed host, e.g. Render, or a tunnel like ngrok/cloudflared when on a LAN).
VOICE_TWIML_URL=

# Minimum time (ms) between two SMS sends, as a backstop against rapid
# polling re-triggering a send. One SMS is already sent per transition
# INTO CRITICAL regardless of this value. Default 0 (off) so every new
# critical event texts immediately — the in-streak dedup prevents
# duplicates.
SMS_ALERT_COOLDOWN_MS=0
