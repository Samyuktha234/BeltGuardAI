# Optional. If unset, the dashboard derives the backend URL from whatever
# host/IP the page was loaded from: http://<page-host>:5000/api
# For local dev, the Vite proxy (vite.config.js) forwards /api to localhost:5000.
# For Render production, set this to your backend URL WITHOUT a trailing slash.
VITE_API_URL=

# Optional. Phone camera live feed via the "IP Webcam" Android app.
# Set this to the app's MJPEG stream URL (shown under "Video streams",
# e.g. http://192.168.x.x:8080/video) — NOT the HTML preview page.
# The dashboard shows this live feed alongside your browser's own
# device camera (getUserMedia). The stream reconnects every ~1.2s to
# keep latency bounded.
VITE_PHONE_CAM_URL=